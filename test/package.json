{
  "name": "link-cross-tests",
  "private": true,
  "description": "The TypeScript client driven against the real Go relay binary.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pretypecheck": "npm --prefix ../client run build",
    "pretest": "npm --prefix ../client run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 \"*.test.ts\""
  },
  "dependencies": {
    "@frontierengineer/link-client": "file:../client"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
