{
  "name": "@frontierengineer/link-client",
  "version": "1.0.0-alpha.3",
  "description": "Client for Link, a private end-to-end encrypted network for one install: rosters, SPAKE2 pairing and Noise IK sessions over a content-blind relay.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierengineer/link.git",
    "directory": "client"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./compression": {
      "types": "./dist/compression.d.ts",
      "import": "./dist/compression.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "vectors": "tsx scripts/vectors.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
